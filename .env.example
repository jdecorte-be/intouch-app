# Server-side secrets — NEVER prefix these with EXPO_PUBLIC_.
# EXPO_PUBLIC_* vars are bundled into the client app that users download.
# These belong to the backend (auth server / API) only.
# Copy this file to `.env` and fill in real values.

EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# retalk.live Next.js backend. Defaults to https://retalk.live when unset.
EXPO_PUBLIC_API_BASE_URL=https://retalk.live

DATABASE_URL=postgresql://user:password@host:port/database

AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@example.com
