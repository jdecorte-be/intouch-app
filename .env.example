# EXPO_PUBLIC_* vars are bundled into the client app that users download,
# so only put values here that are safe to ship in the app binary.
# Copy this file to `.env` and fill in real values.
#
# Backend secrets (DATABASE_URL, SUPERTOKENS_CONNECTION_URI, SUPERTOKENS_API_KEY,
# AUTH_GOOGLE_*, RESEND_API_KEY, etc.) live in ../retalk-api/.env.example now
# that the API is its own NestJS project. Auth itself is handled by
# SuperTokens (supertokens-node on the backend, supertokens-react-native
# here) — see lib/supertokens.ts.

EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# retalk-api backend (NestJS), also SuperTokens' apiDomain. Defaults to
# https://api.retalk.live when unset.
EXPO_PUBLIC_API_BASE_URL=https://api.retalk.live

# Klipy API key, used by the chat GIF picker (partner.klipy.com > API Keys).
# Without it, the GIF button shows an error state.
EXPO_PUBLIC_KLIPY_API_KEY=your-klipy-api-key
