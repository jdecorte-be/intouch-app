{
  "expo": {
    "name": "ReTalk-App",
    "slug": "ReTalk-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "retalkapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ReTalk uses your location to center the event map near you.",
        "NSPhotoLibraryUsageDescription": "ReTalk needs access to your photos so you can set a profile picture and add photos to your profile.",
        "NSCameraUsageDescription": "ReTalk needs access to your camera so you can take a profile picture."
      },
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.jdecorte.ReTalkApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#e3e6ec",
          "dark": {
            "backgroundColor": "#e3e6ec"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ReTalk needs access to your photos so you can set a profile picture and add photos to your profile.",
          "cameraPermission": "ReTalk needs access to your camera so you can take a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
